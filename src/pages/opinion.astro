---
import Base from '../layouts/Base.astro';
import { opinions } from '../data/opinions.js';

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const entries = [...opinions].sort((a, b) => b.date.localeCompare(a.date));
---

<Base
  title="Opinion — Alissa Nicole"
  description="Opinions by Alissa Nicole: long-form essays on scop3, short-form posts on LinkedIn."
  current="opinion"
>
  <h1>Opinion</h1>
  <p class="tagline">Long-form essays on scop3, short-form posts on LinkedIn.</p>

  <ul class="projects">
    {entries.map((w) => (
      <li>
        <a href={w.url}>{w.title}</a>
        <p>{w.source} · {fmt.format(new Date(`${w.date}T00:00:00`))}</p>
      </li>
    ))}
  </ul>
</Base>
