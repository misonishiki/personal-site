---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string; // nav key of the current page, for the underline
}

const { title, description = 'Alissa Nicolet — LCA engineer & software builder', current } = Astro.props;

const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about', label: 'About', key: 'about' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <main>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} Alissa Nicolet</span>
        <a href="mailto:hello@example.com">Email</a>
        <a href="https://www.linkedin.com/" rel="me">LinkedIn</a>
        <a href="https://substack.com/" rel="me">Substack</a>
        <a href="https://github.com/" rel="me">GitHub</a>
      </footer>
    </div>
  </body>
</html>
