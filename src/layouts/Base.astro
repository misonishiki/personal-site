---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string; // nav key of the current page, for the underline
}

const { title, description = 'Alissa Nicole — LCA engineer & software builder', current } = Astro.props;

// TODO(go-live): replace with real values before publishing —
// see .scratch/personal-site-go-live/ in the bunker repo.
const email = 'TODO-email@example.com';
const linkedin = 'https://www.linkedin.com/in/TODO';

const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about', label: 'About', key: 'about' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <main>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} Alissa Nicole</span>
        <a href={`mailto:${email}`}>Email</a>
        <a href={linkedin} rel="me">LinkedIn</a>
        <a href="https://scop3.substack.com/" rel="me">Substack</a>
      </footer>
    </div>
  </body>
</html>
