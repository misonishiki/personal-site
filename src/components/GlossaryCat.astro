---
// The glossary cat: a peeker, not a poser.
// Desktop (hover a .term): the cat rises behind the word, top half showing,
// with a speech bubble to its RIGHT carrying the definition.
// Touch (tap a .term): the cat leans in from the right screen edge, slanted,
// with the bubble to its LEFT.
// Terms: <span class="term" data-term="EPD">EPD</span>; defs: src/data/glossary.js.
// Cat: public/cat.png (cutout collage), swap via CAT_SRC.
import { GLOSSARY } from '../data/glossary.js';
const defs = Object.fromEntries(GLOSSARY.map((g) => [g.term, g.def]));
const CAT_SRC = '/cat.png';
---

<script type="application/json" id="glossary-data" set:html={JSON.stringify(defs)} />
<script define:vars={{ CAT_SRC }}>
  (() => {
    const defs = JSON.parse(document.getElementById('glossary-data').textContent);
    const catHTML = CAT_SRC
      ? `<img src="${CAT_SRC}" alt="" class="gcat-img">`
      : '<span class="gcat-emoji">🐈</span>';

    const inner = (term) => `
      <div class="gcat-peek">${catHTML}</div>
      <div class="gcat-bubble"><strong>${term}</strong><p>${defs[term] || 'Definition coming soon.'}</p></div>`;

    const tip = document.createElement('div');      // desktop hover
    tip.className = 'gcat-tip';
    tip.setAttribute('role', 'tooltip');
    const panel = document.createElement('div');    // touch panel
    panel.className = 'gcat-panel';
    panel.innerHTML = `<button class="gcat-close" aria-label="Close">×</button><div class="gcat-body"></div>`;
    document.body.append(tip, panel);

    panel.querySelector('.gcat-close').addEventListener('click', () => panel.classList.remove('open'));
    document.addEventListener('click', (e) => {
      if (panel.classList.contains('open') && !panel.contains(e.target) && !e.target.closest('.term')) {
        panel.classList.remove('open');
      }
    });

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    document.querySelectorAll('.term').forEach((el) => {
      const term = el.dataset.term;
      el.setAttribute('tabindex', '0');

      el.addEventListener('mouseenter', () => {
        if (!finePointer.matches) return;
        tip.innerHTML = inner(term);
        const r = el.getBoundingClientRect();
        tip.style.left = Math.max(4, Math.min(r.left, window.innerWidth - 340)) + 'px';
        tip.style.top = (r.top + window.scrollY) + 'px';   // bottom edge at the text
        tip.classList.add('show');
      });
      el.addEventListener('mouseleave', () => tip.classList.remove('show'));

      const openPanel = (e) => {
        if (finePointer.matches) return;
        e.preventDefault();
        panel.querySelector('.gcat-body').innerHTML = inner(term);
        panel.classList.add('open');
      };
      el.addEventListener('click', openPanel);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') openPanel(e);
      });
    });
  })();
</script>

<style is:global>
  .term { border-bottom: 1px dotted var(--accent); cursor: help; }

  /* ---- shared bits ---- */
  .gcat-peek {
    overflow: hidden;              /* the "half body cut off" */
    height: 150px;                 /* head + glasses + shoulders */
    width: 135px;
    flex: none;
  }
  .gcat-peek .gcat-img { width: 135px; height: auto; display: block; }
  .gcat-peek .gcat-emoji { font-size: 2.2rem; }
  .gcat-bubble {
    position: relative;
    background: var(--faint);
    border: 1px solid var(--accent);
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
    max-width: 240px;
    font-size: 0.85rem;
    line-height: 1.45;
    box-shadow: 4px 4px 0 rgba(107, 155, 255, 0.25);
  }
  .gcat-bubble p { margin: 0.15rem 0 0; color: var(--muted); overflow-wrap: break-word; }

  /* ---- desktop: cat stands behind the word, bubble to its RIGHT ---- */
  .gcat-tip {
    position: absolute;
    display: flex;
    align-items: flex-end;         /* cat feet on the text line */
    gap: 0.55rem;
    transform: translateY(calc(-100% + 12px));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 90;
  }
  .gcat-tip.show { opacity: 1; transform: translateY(-100%); }
  .gcat-tip .gcat-bubble { margin-bottom: 0.9rem; }
  .gcat-tip .gcat-bubble::before { /* tail pointing left, at the cat */
    content: '';
    position: absolute;
    left: -7px;
    bottom: 14px;
    border: 7px solid transparent;
    border-right-color: var(--accent);
    border-left: 0;
  }

  /* ---- touch: cat leans in from the right edge, bubble to its LEFT ---- */
  .gcat-panel {
    position: fixed;
    right: 0;
    bottom: 12%;
    transform: translateX(115%) rotate(7deg);   /* slanted, off-canvas */
    transition: transform 0.28s cubic-bezier(0.2, 1.1, 0.3, 1);
    z-index: 95;
  }
  .gcat-panel.open { transform: translateX(6%) rotate(7deg); } /* edge of cat offscreen */
  .gcat-panel .gcat-body {
    display: flex;
    flex-direction: row-reverse;   /* bubble on the LEFT of the cat */
    align-items: flex-end;
    gap: 0.55rem;
  }
  .gcat-panel .gcat-peek { height: 210px; width: 190px; }
  .gcat-panel .gcat-peek .gcat-img { width: 190px; }
  @media (max-width: 480px) {          /* keep cat + bubble inside a phone screen */
    .gcat-panel .gcat-peek { width: 110px; height: 122px; }
    .gcat-panel .gcat-peek .gcat-img { width: 110px; }
    .gcat-panel .gcat-bubble { max-width: 52vw; }
  }
  .gcat-panel .gcat-bubble { margin-bottom: 1.2rem; max-width: 200px; }
  .gcat-panel .gcat-bubble::before { /* tail pointing right, at the cat */
    content: '';
    position: absolute;
    right: -7px;
    bottom: 14px;
    border: 7px solid transparent;
    border-left-color: var(--accent);
    border-right: 0;
  }
  .gcat-close {
    display: none;                 /* hidden until the panel opens */
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--faint);
    border: 1px solid var(--accent);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }
  .gcat-panel.open .gcat-close { display: block; }
  .gcat-close:hover { color: var(--ink); }
</style>
