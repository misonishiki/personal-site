---
// The glossary cat: hover a marked term on desktop and the cat rises from the
// word with a definition box; on touch devices, tap the term and the cat panel
// slides in from the bottom-right. Terms are marked with
// <span class="term" data-term="EPD">EPD</span>; definitions come from
// src/data/glossary.js (serialized below for the client script).
// Swap the cat: replace CAT_SRC with a photo in /public (e.g. '/cat.png').
import { GLOSSARY } from '../data/glossary.js';
const defs = Object.fromEntries(GLOSSARY.map((g) => [g.term, g.def]));
const CAT_SRC = '/cat.png'; // the official glossary cat (cutout, glasses + tie)
---

<script type="application/json" id="glossary-data" set:html={JSON.stringify(defs)} />
<script define:vars={{ CAT_SRC }}>
  (() => {
    const defs = JSON.parse(document.getElementById('glossary-data').textContent);
    const catHTML = CAT_SRC
      ? `<img src="${CAT_SRC}" alt="" class="gcat-img">`
      : '<span class="gcat-emoji">🐈</span>';

    // Two shared elements, created once.
    const tip = document.createElement('div');
    tip.className = 'gcat-tip';
    tip.setAttribute('role', 'tooltip');
    const panel = document.createElement('div');
    panel.className = 'gcat-panel';
    panel.innerHTML = `<button class="gcat-close" aria-label="Close">×</button><div class="gcat-body"></div>`;
    document.body.append(tip, panel);

    const fill = (el, term) => {
      const def = defs[term] || 'Definition coming soon.';
      el.innerHTML = `${catHTML}<div class="gcat-text"><strong>${term}</strong><p>${def}</p></div>`;
    };
    fill(tip, '');
    panel.querySelector('.gcat-close').addEventListener('click', () => panel.classList.remove('open'));
    document.addEventListener('click', (e) => {
      if (panel.classList.contains('open') && !panel.contains(e.target) && !e.target.closest('.term')) {
        panel.classList.remove('open');
      }
    });

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    document.querySelectorAll('.term').forEach((el) => {
      const term = el.dataset.term;
      el.setAttribute('tabindex', '0');

      // Desktop: cat hovers up from the word.
      el.addEventListener('mouseenter', () => {
        if (!finePointer.matches) return;
        fill(tip, term);
        const r = el.getBoundingClientRect();
        tip.style.left = Math.max(8, Math.min(r.left, window.innerWidth - 340)) + 'px';
        tip.style.top = (r.top + window.scrollY - 8) + 'px';
        tip.classList.add('show');
      });
      el.addEventListener('mouseleave', () => tip.classList.remove('show'));

      // Touch (and keyboard): cat slides in from the bottom-right.
      el.addEventListener('click', (e) => {
        if (finePointer.matches) return;
        e.preventDefault();
        fill(panel.querySelector('.gcat-body'), term);
        panel.classList.add('open');
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fill(panel.querySelector('.gcat-body'), term);
          panel.classList.add('open');
        }
      });
    });
  })();
</script>

<style is:global>
  /* A defined term: dotted accent underline = "there is a definition here". */
  .term { border-bottom: 1px dotted var(--accent); cursor: help; }

  /* Desktop tooltip: rises up from the word, ends ABOVE it. */
  .gcat-tip {
    position: absolute;
    transform: translateY(calc(-100% + 10px));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
    display: flex;
    gap: 0.6rem;
    align-items: flex-end;
    max-width: 330px;
    background: var(--panel, #1b1a18);
    border: 1px solid var(--accent);
    border-radius: 8px 8px 8px 2px;
    padding: 0.7rem 0.85rem;
    font-size: 0.85rem;
    line-height: 1.45;
    z-index: 90;
    box-shadow: 4px 4px 0 rgba(107, 155, 255, 0.25);
  }
  .gcat-tip.show { opacity: 1; transform: translateY(-100%); }

  /* Mobile panel: bottom-right slide-in. */
  .gcat-panel {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    left: 1rem;
    max-width: 26rem;
    margin-left: auto;
    transform: translateX(120%);
    transition: transform 0.25s ease;
    background: var(--panel, #1b1a18);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.9rem 1rem;
    z-index: 95;
    box-shadow: 4px 4px 0 rgba(107, 155, 255, 0.25);
  }
  .gcat-panel.open { transform: translateX(0); }
  .gcat-panel .gcat-body { display: flex; gap: 0.7rem; align-items: flex-start; }
  .gcat-close {
    position: absolute;
    top: 0.3rem;
    right: 0.55rem;
    background: none;
    border: none;
    color: var(--muted);
    font-size: 1.2rem;
    cursor: pointer;
  }
  .gcat-close:hover { color: var(--ink); }

  .gcat-text p { margin: 0.15rem 0 0; color: var(--muted); }
  .gcat-emoji { font-size: 2rem; line-height: 1; }
  .gcat-img { width: 64px; height: auto; align-self: flex-end; }
</style>
